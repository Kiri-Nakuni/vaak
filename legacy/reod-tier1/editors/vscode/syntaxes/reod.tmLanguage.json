{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "REod",
  "scopeName": "source.reod",
  "patterns": [
    {
      "include": "#block_comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#operator-expression"
    },
    {
      "include": "#jump"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#type"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#return-arrow"
    },
    {
      "include": "#binding-operator"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#call"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.percentage.reod",
      "match": "%.*$"
    },
    "attribute": {
      "comment": "D-18r: #[global, immediate] のようにリストで書け、行末で終端し、次の行の評価方法を変更する",
      "name": "meta.attribute.reod",
      "begin": "(#)(\\[)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.reod"
        },
        "2": {
          "name": "punctuation.section.brackets.begin.reod"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.brackets.end.reod"
        }
      },
      "patterns": [
        {
          "match": "\\b(immediate|global|forward)\\b",
          "name": "storage.modifier.reod"
        },
        {
          "match": "\\b\\w+\\b",
          "name": "invalid.illegal.unknown-attribute.reod"
        }
      ]
    },
    "jump": {
      "comment": "この言語の中心。goto/label/comefrom は他のキーワードと区別する",
      "patterns": [
        {
          "match": "\\b(goto|comefrom)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.control.jump.reod"
            },
            "2": {
              "name": "entity.name.label.reod"
            }
          }
        },
        {
          "match": "\\b(label)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.control.label.reod"
            },
            "2": {
              "name": "entity.name.label.reod"
            }
          }
        }
      ]
    },
    "function-definition": {
      "match": "\\b(fn)\\s+([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "keyword.declaration.reod"
        },
        "2": {
          "name": "entity.name.function.reod"
        }
      }
    },
    "type-definition": {
      "match": "\\b(typ)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.reod"
        },
        "2": {
          "name": "entity.name.type.reod"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(let|fn|typ|flow)\\b",
          "name": "keyword.declaration.reod"
        },
        {
          "comment": "`return` は存在しない（break がブロックの値を束縛して終了する、D-28）。`match` は `switch`（ADT がないのでパターンマッチではない、D-32）。",
          "match": "\\b(if|else|switch|while|loop|nfor|ifor|comp|break|continue|in)\\b",
          "name": "keyword.control.reod"
        },
        {
          "match": "\\bmod\\b",
          "name": "keyword.operator.arithmetic.reod"
        }
      ]
    },
    "builtin": {
      "match": "\\b(write|read|getdepth)\\b",
      "name": "support.function.builtin.reod",
      "comment": "中核の組み込みのみ。printstr / printi32 等はすべて write の糖衣（D-35）"
    },
    "type": {
      "comment": "数値型（設計書 §3.2）と組み込みパラメトリック型",
      "match": "\\b(i64|u64|i32|u32|f32|f64|f80|u8|u16|array|pair|hashmap)\\b",
      "name": "support.type.reod"
    },
    "string": {
      "name": "string.quoted.double.reod",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.reod"
        }
      ]
    },
    "number": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.reod"
    },
    "return-arrow": {
      "comment": "D-8: `->` は宣言位置でも呼出位置でも返り値型を名指す",
      "match": "->",
      "name": "keyword.operator.return-type.reod"
    },
    "binding-operator": {
      "comment": "§4.6: := 新 thunk / &= 共有 / ^= 計算の複製。D-42: `=` は定義であって束縛演算子ではない",
      "match": ":=|&=|\\^=",
      "name": "keyword.operator.binding.reod"
    },
    "operator": {
      "match": "\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||[-+*/<>!]|\\.\\.|:",
      "name": "keyword.operator.reod"
    },
    "call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
      "name": "entity.name.function.call.reod"
    },
    "operator-expression": {
      "comment": "D-38: `$` を読んだ時点で作用素の評価規則へ入る。D-26r: return は組み込みではなく無名標準ライブラリの別名",
      "patterns": [
        {
          "match": "(\\$)(repeat|frame)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.operator.reod"
            },
            "2": {
              "name": "keyword.operator.reod"
            }
          }
        },
        {
          "match": "\\breturn\\b",
          "name": "entity.name.function.macro.reod"
        },
        {
          "match": "(?<![=!<>:+\\-*/])=(?![=>])",
          "name": "keyword.operator.define.reod"
        }
      ]
    },
    "block_comment": {
      "name": "comment.block.reod",
      "comment": "D-69: 無名標準ライブラリのブロックコメント。実行経路では #[flat] goto _comment_ による読み飛ばし。名前を決め打ちしているので、`comment` を再束縛すると食い違う（道具経路の既知の近似）",
      "begin": "(?<![\\\\w.])comment\\\\s*;",
      "end": "(?<![\\\\w.])label\\\\s+_comment_\\\\s*;",
      "beginCaptures": {
        "0": {
          "name": "comment.block.reod"
        }
      },
      "endCaptures": {
        "0": {
          "name": "comment.block.reod"
        }
      }
    }
  }
}
