% 文法カバレッジ用。Tier 1 のインタプリタでは実行できない構文も含む——
% ハイライトは設計書の全体をカバーする必要があるため。

typ uf_tree {
    parent : i64 array;
    rank : i64 array;
    lookup : i64 u64 hashmap;
    span : u64 u64 pair;
}

fn make (size : u64) {
    parent := Array.init(size, 0);
    rank := Array.init(size, 1);
} -> uf_tree;

fn getroot (uf : uf_tree, idx : u64) {
    if (uf.parent[idx] == idx) { idx }
    else {
        #[global]
        uf.parent[idx] := getroot(uf, uf.parent[idx]);
        uf.parent[idx]
    }
} -> u64;

#[immediate]
let n := read();
#[immediate]
let q := read();

% D-8: 呼出側の型アノテーションも `->`
let uf := make(n) -> uf_tree;

let total &= countu64[0];
total := 0;

let init := nfor (i in 0..n) {
    uf.parent[i] := i;
    uf.rank[i] := 1;
} -> i64;

ifor (query in read_lines(q)) {
    let kind := query[0];
    switch kind {
        0 => union(uf, query[1], query[2]);
        1 => print(find(uf, query[1], query[2]));
        _ => print("invalid command");
    }
} comp {
    print(total);
}

while (getroot(uf, 0) != getroot(uf, n - 1)) {
    let x := read();
    let y := read();
    union(uf, x, y);
}

let a := 5;
let b := a;
let c ^= a;
{
    let a := 999;
    print(b);
}
print(c);

goto skip_report;
ifor (x in uf.parent) { print(x); } comp { print("empty"); }
label skip_report;

let retry_count := 0;
comefrom retry;
let input := read();
if (input < 0 || input >= n) {
    print("invalid input, retry");
    retry_count += 1;
    if (retry_count < 3) {
        label retry;
    }
}

print(7 mod 3);
print(-1 + !0 * 2 / 1);

% D-38 / D-39: 作用素式と別名
flow return = $repeat(break, getdepth());
flow leave_two = $repeat(break, 2);

fn guarded (v : i64) {
    if v < 0 { return 0; }
    loop {
        if v > 10 { break break v; }
        break goto tail;
    }
    label tail;
    v
} -> i64;

loop {
    $repeat(break, 1) continue;
}
