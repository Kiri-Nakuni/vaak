% 例5：comefrom トリック
%
% 「この行を、goto で読み飛ばされずに本当に歩いて通過したか」を、
% 専用のブール変数を使わずに検出するイディオム。
%
% 設計書の例からの差分：`\def\MarkRealVisit{...}` を外し、`comefrom` を直接置いた。
% goto の走査は文を一切実行しないので、読み飛ばされた区間に生の `comefrom` が
% あっても登録は起きない——マクロであることはこの挙動に寄与していない。
%
% 期待出力: 0 / 1 / 2 / 4

let pass := 0;
comefrom loop_entry;

print(pass);

if pass == 0 goto shortcut_zero;
if pass == 1 goto real_visit_trigger;

% ここに到達するのは pass >= 2、つまり3周目以降。
% real_visit_trigger が初めて登録される、最初で唯一の機会。
comefrom real_visit_trigger;
pass += 1;
if pass == 4 { print(pass); break 0; }

label real_visit_trigger;
label shortcut_zero;

pass += 1;
label loop_entry;
