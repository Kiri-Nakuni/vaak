% 前の2例は、素直な木走査インタプリタでも同じ出力になる。
% この例はならない。

% ---- (1) 書いても評価されない ----
% z は一度も使われないので、5 / 0 は起きない。

let z := 5 / 0;
print(1);

% `#[immediate]` を付けると束縛の時点で評価され、0 除算になる。
% つまり評価するかどうかは、式ではなく使われ方が決める。

% ---- (2) 副作用も起きない ----
% print(9) は束縛されるだけで、走らない。出力は 2 だけ。

let never := print(9);
print(2);

% ---- (3) 束縛は値ではなく式を持つ ----
% b は「a + 10 という3トークン」を持っている。a の値は持っていない。
% だから a を書き換えてから b を使うと、新しい a で計算される。

let a := 1;
let b := a + 10;
a := 2;
print(b);

% ---- (4) ただし一度きり ----
% b は強制された時点で値になる。以後 a を変えても b は動かない。

a := 100;
print(b);

% ---- (5) 名前は使う場所で引かれる ----
% twice は k を持たない。k は caller の引数である。
% 環境を捕捉しないので、これが通る。

fn twice () { k + k } -> i64;
fn caller (k : i64) { twice() } -> i64;

print(caller(21));

% ---- (6) += は := の糖衣ではない ----
% += は左辺を強制する。:= は式を束ね直すだけなので、自分を参照すると発散する。

let d := 2;
d += 1;
print(d);

% ブロックコメントは字句の機能ではなく、無名標準ライブラリの1行から導出される。
% 読み飛ばされる区間も字句だけは通る必要があるので、`%` コメントと違って
% 使える文字に制限がある（下に句点が無いのはそのため）。

comment;
    ここは実行されない
        d := d + 1;
label _comment_;

% ---- (8) 引数は強制点。ただし呼び出しが起きる時点は遅い ----
% v は使われなくても評価される（`f(5 / 0)` は 0 除算になる）。
% だが r が強制されるまで呼び出し自体が起きないので、
% 「引数を評価する時点」の方が動く。

let n := 1;
fn g (v : i64) { v } -> i64;
let r := g(n);
n := 100;
print(r);

print(0);

% ---- (9) 「捕捉」ではなく「初回の強制」 ----
% b2 は定義時の a2 も、その次の a2 も見ない。
% 最初に値が必要になった時点の a2 だけを見て、そこで固まる。

let a2 := 1;
let b2 := a2 + 10;
a2 := 2;
a2 := 100;
print(b2);

% ---- (10) (1) の答え合わせ。ここでプログラムは落ちる ----
% 5 / 0 は束縛の時点では起きず、z を使った時点で起きる。
% ゼロ除算が値になるのではなく、式が走っていないだけである。

print(z);
