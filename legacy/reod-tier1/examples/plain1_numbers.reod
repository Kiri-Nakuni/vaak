% ありふれた数の関数をいくつか。

fn gcd (a : i64, b : i64) {
    if b == 0 { return a; }
    gcd(b, a mod b)
} -> i64;

fn is_prime (n : i64) {
    if n < 2 { return 0; }
    let d := 2;
    loop {
        if d * d > n break;
        if n mod d == 0 { return 0; }
        d += 1;
    }
    1
} -> i64;

fn pow (base : i64, e : i64) {
    let acc := 1;
    let i := 0;
    loop {
        if i == e break;
        acc *= base;
        i += 1;
    }
    acc
} -> i64;

fn digit_sum (n : i64) {
    let s := 0;
    let m := n;
    loop {
        if m == 0 break;
        s += m mod 10;
        m /= 10;
    }
    s
} -> i64;

print(gcd(48, 18));
print(is_prime(97));
print(is_prime(91));
print(pow(2, 10));
print(digit_sum(9875));
