% 例3：関数と loop（Collatz ステップ数）
%
% 設計書の例からの差分：
%   - `while` は Tier 1 未実装なので `loop` + `break` に展開した
%   - 関数定義は改行で終端する（D-21r）。`;` は要らない
%   - `x := x / 2` は遅延だと自己参照 thunk になるので `#[immediate]`（D-17）
%
% 関数本体はスコープなので、x も count も呼び出しごとに独立している。
% ループ本体はスコープではなくチェックポイントなので（D-2r）、
% count の蓄積はループを抜けても残る——`#[global]` は要らない。

fn collatz_steps (start : u64) {
    let x := start;
    let count := 0;
    loop {
        if x == 1 break;
        if x mod 2 == 0 {
            #[immediate]
            x := x / 2;
        } else {
            #[immediate]
            x := 3 * x + 1;
        }
        count += 1;
    }
    count
} -> u64;

print(collatz_steps(27));
print(collatz_steps(97));
print(collatz_steps(871));
