% 遅延は「値の計算」ではなく「式の評価」を先送りする。副作用も含めて。
% この3例は、値の例より先に置く（D-70 の義務）。

% ---- 例1 参照されなければ、副作用も計算も起きない ----

let a1 := { print(99); 1 + 1 };
print(0);

% ---- 例2 参照されれば、副作用も計算も一度だけ起きる ----

let a2 := { print(99); 1 + 1 };
print(a2);
print(a2);

% ---- 例3 再束縛は新しいセルを作る。古いセルは強制されずに捨てられる ----

let a3 := { print(99); 1 };
a3 := { print(88); 2 };
print(a3);
print(a3);
