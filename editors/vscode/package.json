{
  "name": "vaak",
  "displayName": "Vaak",
  "description": "埋め込みスクリプト言語 Vaak の言語サーバと色分け",
  "version": "0.1.0",
  "publisher": "arimura-akihiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.trap.jp/Suima/vaak.git"
  },
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:vaak"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vaak",
        "aliases": ["Vaak", "vaak"],
        "extensions": [".vaak", ".vk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vaak",
        "scopeName": "source.vaak",
        "path": "./syntaxes/vaak.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Vaak",
      "properties": {
        "vaak.server.path": {
          "type": "string",
          "default": "",
          "description": "言語サーバの道。空なら同梱版を使い、無ければPATHからvaak-lspを探す"
        },
        "vaak.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "言語サーバを使うか。false なら色分けだけになる"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "compile": "npm run check && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check && node esbuild.js --production",
    "package:vsix": "node package-vsix.js",
    "package:vsix:portable": "node package-vsix.js --portable",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "^5.4.0"
  }
}
