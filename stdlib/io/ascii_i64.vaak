%{ 既存 str/u8 操作だけを使う競技入力向けの小さな層。

   stdin/stdout や標準 host 名は定義しない。host が一括で渡した str と
   最上位から返す str の間だけを扱う。公開関数は io_ascii_i64_ で始まる。 }%

flow $io_ascii_i64_return = $repeat(break, getdepth());

fn io_ascii_i64__is_whitespace (byte : u8) {
    byte == 0x20 || (byte >= 0x09 && byte <= 0x0d)
} -> u1;

% position 以降に ASCII whitespace でない byte があるか。範囲外は paradox。%
fn io_ascii_i64_has_next (source : str alias, position : i64) {
    if (position < 0 || position > source.len()) $io_ascii_i64_return; fi;
    var cursor := position;
    while (cursor < source.len() &&
           io_ascii_i64__is_whitespace(source[cursor] ?? $io_ascii_i64_return)) {
        cursor += 1;
    };
    cursor < source.len()
} -> u1;

%{ ASCII whitespace を飛ばして i64 を一つ読む。
   先頭の + / - を許す。token が空、数字以外を含む、i64 範囲外なら paradox。
   失敗時は position を変更しない。成功時は数字直後（区切りの前）へ進める。 }%
fn io_ascii_i64_read (source : str alias, var position : i64 alias) {
    if (position < 0 || position > source.len()) $io_ascii_i64_return; fi;
    var cursor := position;
    while (cursor < source.len() &&
           io_ascii_i64__is_whitespace(source[cursor] ?? $io_ascii_i64_return)) {
        cursor += 1;
    };
    if (cursor == source.len()) $io_ascii_i64_return; fi;

    var negative := false;
    let first := source[cursor] ?? $io_ascii_i64_return;
    if (first == 0x2d) {
        negative := true;
        cursor += 1;
    } elif (first == 0x2b) {
        cursor += 1;
    } fi;
    if (cursor == source.len()) $io_ascii_i64_return; fi;

    var value := 0;
    var digits := 0;
    while (cursor < source.len()) {
        let byte := source[cursor] ?? $io_ascii_i64_return;
        if (byte < 0x30 || byte > 0x39) break; fi;
        let digit := (byte - 0x30) -> i64;
        if (value < (0 - 922337203685477580)) $io_ascii_i64_return; fi;
        if (value == (0 - 922337203685477580) &&
            ((! negative && digit > 7) || (negative && digit > 8))) {
            $io_ascii_i64_return;
        } fi;
        value := value * 10 - digit;
        digits += 1;
        cursor += 1;
    };
    if (digits == 0) $io_ascii_i64_return; fi;
    if (cursor < source.len() &&
        ! io_ascii_i64__is_whitespace(source[cursor] ?? $io_ascii_i64_return)) {
        $io_ascii_i64_return;
    } fi;
    position := cursor;
    if (negative) value else 0 - value fi
} -> i64;

% i64 を十進 ASCII で追記する。i64::MIN も扱う。成功は true。%
fn io_ascii_i64_append (var output : str alias, value : i64) {
    if (value == 0) {
        output.push(0x30);
        $io_ascii_i64_return true;
    } fi;
    if (value < 0) output.push(0x2d); fi;

    % 正の最大値を越える i64::MIN を扱うため、負のまま桁を剥がす。%
    var remaining := if (value > 0) 0 - value else value fi;
    var reversed : u8 array := new u8 array(0, 0);
    while (remaining < 0) {
        let digit := (0 - (remaining mod 10)) mod 10;
        reversed.push(0x30 + (digit -> u8));
        remaining := (remaining + digit) / 10;
    };
    while (reversed.len() > 0) {
        output.push(reversed.pop() ?? $io_ascii_i64_return);
    };
    true
} -> u1;

fn io_ascii_i64_append_space (var output : str alias) {
    output.push(0x20);
    true
} -> u1;

fn io_ascii_i64_append_newline (var output : str alias) {
    output.push(0x0a);
    true
} -> u1;

%{
   sourceからcount個を連続して読み、output[first..first+count)へ書く。
   一つの関数frame内でparseし、tokenごとの一時文字列を作らない。

   countと出力範囲の違反は何も変更せずparadox。token途中の失敗は、それ以前に
   成功した値とpositionを保持し、失敗したtokenの出力欄とpositionは変更しない。
}%
fn io_ascii_i64_read_n_into (
    source : str alias,
    var position : i64 alias,
    var output : i64 array alias,
    first : i64,
    count : i64
) {
    if (position < 0 || position > source.len() ||
        first < 0 || first > output.len() ||
        count < 0 || count > output.len() - first) {
        $io_ascii_i64_return;
    } fi;

    var target := first;
    let end := first + count;
    while (target < end) {
        var cursor := position;
        while (cursor < source.len()) {
            let whitespace := source[cursor] ?? $io_ascii_i64_return;
            if (! (whitespace == 0x20 ||
                   (whitespace >= 0x09 && whitespace <= 0x0d))) break; fi;
            cursor += 1;
        };
        if (cursor == source.len()) $io_ascii_i64_return; fi;

        var negative := false;
        let first_byte := source[cursor] ?? $io_ascii_i64_return;
        if (first_byte == 0x2d) {
            negative := true;
            cursor += 1;
        } elif (first_byte == 0x2b) {
            cursor += 1;
        } fi;
        if (cursor == source.len()) $io_ascii_i64_return; fi;

        var value := 0;
        var digits := 0;
        while (cursor < source.len()) {
            let byte := source[cursor] ?? $io_ascii_i64_return;
            if (byte < 0x30 || byte > 0x39) break; fi;
            let digit := (byte - 0x30) -> i64;
            if (value < (0 - 922337203685477580)) $io_ascii_i64_return; fi;
            if (value == (0 - 922337203685477580) &&
                ((! negative && digit > 7) || (negative && digit > 8))) {
                $io_ascii_i64_return;
            } fi;
            value := value * 10 - digit;
            digits += 1;
            cursor += 1;
        };
        if (digits == 0) $io_ascii_i64_return; fi;
        if (cursor < source.len()) {
            let delimiter := source[cursor] ?? $io_ascii_i64_return;
            if (! (delimiter == 0x20 ||
                   (delimiter >= 0x09 && delimiter <= 0x0d))) {
                $io_ascii_i64_return;
            } fi;
        } fi;

        output[target] := if (negative) value else 0 - value fi;
        position := cursor;
        target += 1;
    };
    true
} -> u1;

%{
   values[first..last)を十進ASCIIへ変換し、separatorを値の間にだけ置く。
   結果strと20-byte scratchを一度ずつ確保し、整数ごとの配列確保をしない。
   有効な空区間は空str。範囲外と非ASCII separatorはparadox。
}%
fn io_ascii_i64_format_range (
    values : i64 array alias,
    first : i64,
    last : i64,
    separator : u8
) {
    if (first < 0 || first > last || last > values.len() || separator > 0x7f) {
        $io_ascii_i64_return;
    } fi;

    var output := "";
    var scratch : u8 array := new u8 array(20, 0);
    var index := first;
    while (index < last) {
        if (index > first) output.push(separator); fi;
        let value := values[index] ?? $io_ascii_i64_return;
        if (value == 0) {
            output.push(0x30);
        } else {
            if (value < 0) output.push(0x2d); fi;
            var remaining := if (value > 0) 0 - value else value fi;
            var digits := 0;
            while (remaining < 0) {
                let digit := (0 - (remaining mod 10)) mod 10;
                scratch[digits] := 0x30 + (digit -> u8);
                digits += 1;
                remaining := (remaining + digit) / 10;
            };
            while (digits > 0) {
                digits -= 1;
                output.push(scratch[digits] ?? $io_ascii_i64_return);
            };
        } fi;
        index += 1;
    };
    output
} -> str;
