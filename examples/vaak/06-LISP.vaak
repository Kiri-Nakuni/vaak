%{ 整数を値に持つ、小さな S 式インタープリター。

   実装する形:
     整数、名前
     (+ ...), (* ...), (- ...), (/ ...)
     (= a b), (< a b)
     (if condition then else)
     (let name value body)
     (do ...)

   構文木を自己参照構造体にはせず、トークン列を読みながら
   「値と次に読む位置」を返す。これなら STEEL でも走る。 }%

% STEEL は無名標準ライブラリをまだ注入しないので、同じ定義を明示する。
flow $return = $repeat(break, getdepth());

%{ token 列の位置と、環境・配列の一般の添字を取り違えないための包み。
   現行仕様では比較・算術・添字のたびに i64 へ明示的に剥がす。 }%
wrap TokenPos = i64;

struct Step {
    let ok : u1 := false;
    let value : i64 := 0;
    let next : TokenPos := new TokenPos(0);
};

fn failed () {
    new Step ( ok := false )
} -> Step;

fn is_space (c : u8) {
    c == 32 || c == 10 || c == 9 || c == 13
} -> u1;

fn same (a : str alias, b : str alias) {
    if (a.len() != b.len()) $return false; fi;
    nfor (i, 0, a.len()) {
        if (a[i] != b[i]) $return false; fi;
    };
    true
} -> u1;

fn is_number (word : str alias) {
    if (word.len() == 0) $return false; fi;
    var i := 0;
    if (word[0] == 45) {
        if (word.len() == 1) $return false; fi;
        i := 1;
    } fi;
    while (i < word.len()) {
        let c := word[i] ?? 0;
        if (c < 48 || c > 57) $return false; fi;
        i += 1;
    };
    true
} -> u1;

fn parse_number (word : str alias) {
    if (! is_number(word)) $return; fi;
    var i := 0;
    var negative := false;
    if (word[0] == 45) {
        negative := true;
        i := 1;
    } fi;
    var value := 0;
    while (i < word.len()) {
        value := value * 10 + (word[i] - 48) -> i64;
        i += 1;
    };
    if (negative) 0 - value else value fi
} -> i64;

%{ 文字列比較を使わず、演算子を小さな番号へ畳む。
   文字列の内容比較を明示した方が、STEEL の集合体表現に依存しない。 }%
fn operator_kind (word : str alias) {
    if (word.len() == 1) {
        let c := word[0] ?? 0;
        if (c == 43) $return 1; fi;  %{ + }%
        if (c == 42) $return 2; fi;  %{ * }%
        if (c == 45) $return 3; fi;  %{ - }%
        if (c == 47) $return 4; fi;  %{ / }%
        if (c == 61) $return 5; fi;  %{ = }%
        if (c == 60) $return 6; fi;  %{ < }%
    } fi;
    if (word.len() == 2) {
        if (word[0] == 105 && word[1] == 102) $return 7; fi;  %{ if }%
        if (word[0] == 100 && word[1] == 111) $return 9; fi;  %{ do }%
    } fi;
    if (word.len() == 3) {
        if (word[0] == 108 && word[1] == 101 && word[2] == 116) $return 8; fi; %{ let }%
    } fi;
    0
} -> i64;

fn tokenize (source : str alias) {
    var tokens : str array := new str array(0, "");
    var current : str := "";
    nfor (i, 0, source.len()) {
        let c := source[i] ?? 32;
        if (is_space(c)) {
            if (current.len() > 0) {
                tokens.push(current);
                current.clear();
            } fi;
        } elif (c == 40 || c == 41) {
            if (current.len() > 0) {
                tokens.push(current);
                current.clear();
            } fi;
            var paren : str := "";
            paren.push(c);
            tokens.push(paren);
        } else {
            current.push(c);
        } fi;
    };
    if (current.len() > 0) tokens.push(current); fi;
    tokens
} -> str array;

fn lookup (names : str array alias, values : i64 array alias, name : str alias) {
    var i := names.len();
    while (i > 0) {
        i -= 1;
        let candidate := names[i];
        if (same(candidate, name)) {
            $return new Step ( ok := true, value := values[i] );
        } fi;
    };
    failed()
} -> Step;

%{ 式を評価せず、その直後まで進める。if の選ばれない腕に使う。 }%
fn skip (tokens : str array alias, pos : TokenPos) {
    if ((pos -> i64) < 0 || (pos -> i64) >= tokens.len())
        $return new TokenPos(0 - 1);
    fi;
    let first := tokens[pos -> i64];
    if (first.len() != 1 || first[0] != 40)
        $return new TokenPos((pos -> i64) + 1);
    fi;

    var depth := 1;
    var i := new TokenPos((pos -> i64) + 1);
    while (depth > 0) {
        if ((i -> i64) >= tokens.len()) $return new TokenPos(0 - 1); fi;
        let token := tokens[i -> i64];
        if (token.len() == 1) {
            if (token[0] == 40) depth += 1;
            elif (token[0] == 41) depth -= 1;
            fi;
        } fi;
        i := new TokenPos((i -> i64) + 1);
    };
    i
} -> TokenPos;

fn close_after (tokens : str array alias, pos : TokenPos) {
    if ((pos -> i64) < 0 || (pos -> i64) >= tokens.len())
        $return new TokenPos(0 - 1);
    fi;
    let token := tokens[pos -> i64];
    if (token.len() == 1 && token[0] == 41)
        new TokenPos((pos -> i64) + 1)
    else
        new TokenPos(0 - 1)
    fi
} -> TokenPos;

fn eval (tokens : str array alias, pos : TokenPos,
         names : str array alias, values : i64 array alias) {
    if ((pos -> i64) < 0 || (pos -> i64) >= tokens.len()) $return failed(); fi;
    let token := tokens[pos -> i64];

    %{ 原子は整数か、環境にある名前。 }%
    if (token.len() != 1 || token[0] != 40) {
        if (is_number(token)) {
            $return new Step (
                ok := true,
                value := parse_number(token),
                next := new TokenPos((pos -> i64) + 1)
            );
        } fi;
        let found := lookup(names, values, token);
        if (! found.ok) $return failed(); fi;
        $return new Step (
            ok := true,
            value := found.value,
            next := new TokenPos((pos -> i64) + 1)
        );
    } fi;

    if ((pos -> i64) + 1 >= tokens.len()) $return failed(); fi;
    let op := tokens[(pos -> i64) + 1];
    let kind := operator_kind(op);
    if (kind == 0) $return failed(); fi;

    %{ + と * は零個以上の引数を取る。 }%
    if (kind == 1 || kind == 2) {
        var cursor := new TokenPos((pos -> i64) + 2);
        var total := if (kind == 1) 0 else 1 fi;
        while ((cursor -> i64) < tokens.len()) {
            let here := tokens[cursor -> i64];
            if (here.len() == 1 && here[0] == 41) {
                $return new Step (
                    ok := true,
                    value := total,
                    next := new TokenPos((cursor -> i64) + 1)
                );
            } fi;
            let part := eval(tokens, cursor, names, values);
            if (! part.ok) $return failed(); fi;
            if (kind == 1) total += part.value; else total *= part.value; fi;
            cursor := part.next;
        };
        $return failed();
    } fi;

    %{ - と / は先頭を初期値にして、残りを左から畳む。
       - の一引数形だけは符号反転になる。 }%
    if (kind == 3 || kind == 4) {
        let first := eval(tokens, new TokenPos((pos -> i64) + 2), names, values);
        if (! first.ok) $return failed(); fi;
        var cursor := first.next;
        var total := first.value;
        var count := 1;
        while ((cursor -> i64) < tokens.len()) {
            let here := tokens[cursor -> i64];
            if (here.len() == 1 && here[0] == 41) {
                if (kind == 3 && count == 1) total := 0 - total; fi;
                $return new Step (
                    ok := true,
                    value := total,
                    next := new TokenPos((cursor -> i64) + 1)
                );
            } fi;
            let part := eval(tokens, cursor, names, values);
            if (! part.ok) $return failed(); fi;
            if (kind == 3) {
                total -= part.value;
            } else {
                if (part.value == 0) $return failed(); fi;
                total := total / part.value;
            } fi;
            count += 1;
            cursor := part.next;
        };
        $return failed();
    } fi;

    %{ 比較は二引数。真を 1、偽を 0 として返す。 }%
    if (kind == 5 || kind == 6) {
        let left := eval(tokens, new TokenPos((pos -> i64) + 2), names, values);
        if (! left.ok) $return failed(); fi;
        let right := eval(tokens, left.next, names, values);
        if (! right.ok) $return failed(); fi;
        let next := close_after(tokens, right.next);
        if ((next -> i64) < 0) $return failed(); fi;
        let answer := if (kind == 5) {
            if (left.value == right.value) 1 else 0 fi
        } else {
            if (left.value < right.value) 1 else 0 fi
        } fi;
        $return new Step ( ok := true, value := answer, next := next );
    } fi;

    %{ if は選んだ腕だけ評価する。選ばない腕は skip で構文だけ飛ばす。 }%
    if (kind == 7) {
        let condition := eval(tokens, new TokenPos((pos -> i64) + 2), names, values);
        if (! condition.ok) $return failed(); fi;
        if (condition.value != 0) {
            let yes := eval(tokens, condition.next, names, values);
            if (! yes.ok) $return failed(); fi;
            let after_no := skip(tokens, yes.next);
            if ((after_no -> i64) < 0) $return failed(); fi;
            let next := close_after(tokens, after_no);
            if ((next -> i64) < 0) $return failed(); fi;
            $return new Step ( ok := true, value := yes.value, next := next );
        } else {
            let no_pos := skip(tokens, condition.next);
            if ((no_pos -> i64) < 0) $return failed(); fi;
            let no := eval(tokens, no_pos, names, values);
            if (! no.ok) $return failed(); fi;
            let next := close_after(tokens, no.next);
            if ((next -> i64) < 0) $return failed(); fi;
            $return new Step ( ok := true, value := no.value, next := next );
        } fi;
    } fi;

    %{ let は環境を深く複製してから名前を足す。
       本体から戻れば古い環境がそのまま残り、後始末が要らない。 }%
    if (kind == 8) {
        if ((pos -> i64) + 2 >= tokens.len()) $return failed(); fi;
        let name := tokens[(pos -> i64) + 2];
        if (name.len() == 1 && (name[0] == 40 || name[0] == 41)) $return failed(); fi;
        let bound := eval(tokens, new TokenPos((pos -> i64) + 3), names, values);
        if (! bound.ok) $return failed(); fi;
        var scoped_names := names;
        var scoped_values := values;
        scoped_names.push(name);
        scoped_values.push(bound.value);
        let body := eval(tokens, bound.next, scoped_names, scoped_values);
        if (! body.ok) $return failed(); fi;
        let next := close_after(tokens, body.next);
        if ((next -> i64) < 0) $return failed(); fi;
        $return new Step ( ok := true, value := body.value, next := next );
    } fi;

    %{ do は最後の値を返す。空の do は 0。 }%
    if (kind == 9) {
        var cursor := new TokenPos((pos -> i64) + 2);
        var value := 0;
        while ((cursor -> i64) < tokens.len()) {
            let here := tokens[cursor -> i64];
            if (here.len() == 1 && here[0] == 41) {
                $return new Step (
                    ok := true,
                    value := value,
                    next := new TokenPos((cursor -> i64) + 1)
                );
            } fi;
            let part := eval(tokens, cursor, names, values);
            if (! part.ok) $return failed(); fi;
            value := part.value;
            cursor := part.next;
        };
    } fi;
    failed()
} -> Step;

fn run_lisp (source : str alias) {
    let tokens := tokenize(source);
    let names : str array := new str array(0, "");
    let values : i64 array := new i64 array(0, 0);
    let result := eval(tokens, new TokenPos(0), names, values);
    if (! result.ok) $return; fi;
    if ((result.next -> i64) != tokens.len()) $return; fi;
    result.value
} -> i64;

%{ 選ばれない else は 1 / 0 だが、if はその腕を評価しない。
   内側の x は 40、外側の x は 6 のままなので、主例の答えは 42。 }%
let main_program := "(let x 6 (do (let x 40 (+ x 2)) (if (= (* x 7) 42) (+ x 36) (/ 1 0))))";
let arithmetic_program := "(- (* 5 5) (/ 9 3) 2)";
let else_program := "(if (< 3 -2) 99 (/ 20 4))";
let main_answer := run_lisp(main_program) ?? 0;
let arithmetic_answer := run_lisp(arithmetic_program) ?? 0;
let else_answer := run_lisp(else_program) ?? 0;

%{ 支持する演算をまとめて回帰試験しつつ、最上位の答えは 42 に保つ。 }%
if (main_answer == 42 && arithmetic_answer == 20 && else_answer == 5) 42 else 0 fi
