%{ 最小の例。ホストに 6 を返す。 }%

fn gcd (a : i64, b : i64) {
    if (b == 0) a else gcd(b, a mod b) fi
} -> i64;

fn find (a : i64 array alias, x : i64) {
    nfor (i, 0, a.len()) {
        if (a[i] == x) $return i; fi;
    };
} -> i64;

var xs := [ 3, 1, 4, 1, 5 ];
let pos := find(xs, 4) ?? (0 - 1);   % 2

gcd(48, 18)                          % 6
